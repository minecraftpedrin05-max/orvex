# Copie este arquivo para ".env" e ajuste. Linhas começadas com # são comentários.

PORT=3000

# ---------- Modelo de IA (qualquer servidor compatível com OpenAI: Ollama, llama.cpp, vLLM...) ----------
MODEL_PROVIDER=openai
MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_API_KEY=
# Modelo por velocidade. Se quiser um só, use MODEL=nome.
MODEL_FAST=qwen2.5:3b
MODEL_MID=qwen2.5:7b
MODEL_SLOW=qwen2.5:7b
# Modelo de código: usado sozinho quando o pedido é de programação (site, app, bot, jogo, erro, código...).
MODEL_CODE_FAST=qwen2.5-coder:3b
MODEL_CODE=qwen2.5-coder:7b
# MODEL_CODE_SLOW=devstral:24b
# Modelo de visão: liga sozinho quando a pessoa manda foto ou vídeo e descreve para a IA. "off" desliga.
MODEL_VISION=qwen3-vl:4b

# ---------- Gerar imagem ----------
# Endereço de um servidor de imagem. Sem isso, a IA não gera imagem.
# stable-diffusion.cpp:  sd-server --listen-port 7860 ...   -> IMAGE_BASE_URL=http://127.0.0.1:7860  IMAGE_API=a1111
# IMAGE_BASE_URL=
# IMAGE_API=a1111          # a1111 (/sdapi/v1/txt2img) ou openai (/v1/images/generations)
# IMAGE_MODEL=
# IMAGE_SIZE=512
# IMAGE_STEPS=4            # modelos "turbo" e "schnell" usam 1 a 4 passos
# IMAGE_CFG=1
IMAGE_DAILY_LIMIT=10       # imagens por pessoa por dia

# ---------- Terminal da IA ----------
# off = desligado | docker = isolado (recomendado) | local = roda direto no servidor (só para uso pessoal)
EXEC_MODE=off
# EXEC_DOCKER_IMAGE=node:22-bookworm
# EXEC_NETWORK=none
# CHROME_BIN=/usr/bin/chromium

# ---------- Login ----------
# Google: crie um "ID do cliente OAuth" (tipo Web) em console.cloud.google.com e cole aqui.
# GOOGLE_CLIENT_ID=
# E-mail com código: crie uma chave em resend.com. Sem ela o código aparece só no console do servidor.
# RESEND_API_KEY=
# MAIL_FROM=ORVEX <onboarding@resend.dev>
MIN_AGE=13

# ---------- Conectores ----------
# 1 = deixa a IA e os conectores acessarem endereços da rede interna (localhost, 192.168.x.x). Deixe 0 em servidor público.
ALLOW_PRIVATE_URLS=0

# ---------- Limites ----------
DAILY_LIMIT=200
MAX_UPLOAD_MB=25
